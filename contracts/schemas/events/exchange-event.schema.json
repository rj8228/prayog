{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prayog.dev/schemas/events/exchange-event.schema.json",
  "title": "Exchange event",
  "description": "Every event the matching engine produces. Published to Kafka topic prayog.exchange.events.v1, keyed by symbol (SessionStateChanged has no symbol and uses an empty key). seq is the event ID: consumers use it to skip duplicates, because delivery is at-least-once.",
  "type": "object",
  "required": [
    "type",
    "seq",
    "simTime"
  ],
  "properties": {
    "type": {
      "enum": [
        "OrderAccepted",
        "OrderRejected",
        "OrderCancelled",
        "OrderModified",
        "Trade",
        "BookUpdate",
        "SessionStateChanged"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "OrderAccepted"
          }
        }
      },
      "then": {
        "$ref": "#/$defs/OrderAccepted"
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "OrderRejected"
          }
        }
      },
      "then": {
        "$ref": "#/$defs/OrderRejected"
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "OrderCancelled"
          }
        }
      },
      "then": {
        "$ref": "#/$defs/OrderCancelled"
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "OrderModified"
          }
        }
      },
      "then": {
        "$ref": "#/$defs/OrderModified"
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "Trade"
          }
        }
      },
      "then": {
        "$ref": "#/$defs/Trade"
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "BookUpdate"
          }
        }
      },
      "then": {
        "$ref": "#/$defs/BookUpdate"
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "SessionStateChanged"
          }
        }
      },
      "then": {
        "$ref": "#/$defs/SessionStateChanged"
      }
    }
  ],
  "$defs": {
    "OrderAccepted": {
      "description": "The order passed all checks and has an order ID. For a LIMIT order, any part not filled immediately rests on the book.",
      "type": "object",
      "required": [
        "type",
        "seq",
        "simTime",
        "orderId",
        "clientOrderId",
        "accountId",
        "symbol",
        "side",
        "orderType",
        "quantity"
      ],
      "properties": {
        "type": {
          "const": "OrderAccepted"
        },
        "seq": {
          "$ref": "../common.schema.json#/$defs/seq"
        },
        "simTime": {
          "$ref": "../common.schema.json#/$defs/simTime"
        },
        "orderId": {
          "$ref": "../common.schema.json#/$defs/orderId"
        },
        "clientOrderId": {
          "$ref": "../common.schema.json#/$defs/clientOrderId"
        },
        "accountId": {
          "$ref": "../common.schema.json#/$defs/accountId"
        },
        "symbol": {
          "$ref": "../common.schema.json#/$defs/symbol"
        },
        "side": {
          "$ref": "../common.schema.json#/$defs/side"
        },
        "orderType": {
          "$ref": "../common.schema.json#/$defs/orderType"
        },
        "price": {
          "$ref": "../common.schema.json#/$defs/price"
        },
        "quantity": {
          "$ref": "../common.schema.json#/$defs/quantity"
        }
      }
    },
    "OrderRejected": {
      "description": "A new, cancel or modify request was refused. orderId is present when the request named an existing order.",
      "type": "object",
      "required": [
        "type",
        "seq",
        "simTime",
        "clientOrderId",
        "accountId",
        "symbol",
        "reason"
      ],
      "properties": {
        "type": {
          "const": "OrderRejected"
        },
        "seq": {
          "$ref": "../common.schema.json#/$defs/seq"
        },
        "simTime": {
          "$ref": "../common.schema.json#/$defs/simTime"
        },
        "orderId": {
          "$ref": "../common.schema.json#/$defs/orderId"
        },
        "clientOrderId": {
          "$ref": "../common.schema.json#/$defs/clientOrderId"
        },
        "accountId": {
          "$ref": "../common.schema.json#/$defs/accountId"
        },
        "symbol": {
          "$ref": "../common.schema.json#/$defs/symbol"
        },
        "reason": {
          "$ref": "../common.schema.json#/$defs/rejectReason"
        }
      }
    },
    "OrderCancelled": {
      "description": "The open part of an order was removed from the book.",
      "type": "object",
      "required": [
        "type",
        "seq",
        "simTime",
        "orderId",
        "accountId",
        "symbol",
        "cancelledQuantity",
        "reason"
      ],
      "properties": {
        "type": {
          "const": "OrderCancelled"
        },
        "seq": {
          "$ref": "../common.schema.json#/$defs/seq"
        },
        "simTime": {
          "$ref": "../common.schema.json#/$defs/simTime"
        },
        "orderId": {
          "$ref": "../common.schema.json#/$defs/orderId"
        },
        "accountId": {
          "$ref": "../common.schema.json#/$defs/accountId"
        },
        "symbol": {
          "$ref": "../common.schema.json#/$defs/symbol"
        },
        "cancelledQuantity": {
          "$ref": "../common.schema.json#/$defs/quantity"
        },
        "reason": {
          "$ref": "../common.schema.json#/$defs/cancelReason"
        }
      }
    },
    "OrderModified": {
      "description": "Price or quantity changed. quantity is the new total; leavesQuantity is what is still open.",
      "type": "object",
      "required": [
        "type",
        "seq",
        "simTime",
        "orderId",
        "accountId",
        "symbol",
        "price",
        "quantity",
        "leavesQuantity"
      ],
      "properties": {
        "type": {
          "const": "OrderModified"
        },
        "seq": {
          "$ref": "../common.schema.json#/$defs/seq"
        },
        "simTime": {
          "$ref": "../common.schema.json#/$defs/simTime"
        },
        "orderId": {
          "$ref": "../common.schema.json#/$defs/orderId"
        },
        "accountId": {
          "$ref": "../common.schema.json#/$defs/accountId"
        },
        "symbol": {
          "$ref": "../common.schema.json#/$defs/symbol"
        },
        "price": {
          "$ref": "../common.schema.json#/$defs/price"
        },
        "quantity": {
          "$ref": "../common.schema.json#/$defs/quantity"
        },
        "leavesQuantity": {
          "$ref": "../common.schema.json#/$defs/quantity"
        }
      }
    },
    "Trade": {
      "description": "Two orders matched. price is the resting (passive) order's price.",
      "type": "object",
      "required": [
        "type",
        "seq",
        "simTime",
        "tradeId",
        "symbol",
        "price",
        "quantity",
        "aggressorSide",
        "buyOrderId",
        "sellOrderId",
        "buyAccountId",
        "sellAccountId"
      ],
      "properties": {
        "type": {
          "const": "Trade"
        },
        "seq": {
          "$ref": "../common.schema.json#/$defs/seq"
        },
        "simTime": {
          "$ref": "../common.schema.json#/$defs/simTime"
        },
        "tradeId": {
          "$ref": "../common.schema.json#/$defs/tradeId"
        },
        "symbol": {
          "$ref": "../common.schema.json#/$defs/symbol"
        },
        "price": {
          "$ref": "../common.schema.json#/$defs/price"
        },
        "quantity": {
          "$ref": "../common.schema.json#/$defs/quantity"
        },
        "aggressorSide": {
          "$ref": "../common.schema.json#/$defs/side"
        },
        "buyOrderId": {
          "$ref": "../common.schema.json#/$defs/orderId"
        },
        "sellOrderId": {
          "$ref": "../common.schema.json#/$defs/orderId"
        },
        "buyAccountId": {
          "$ref": "../common.schema.json#/$defs/accountId"
        },
        "sellAccountId": {
          "$ref": "../common.schema.json#/$defs/accountId"
        }
      }
    },
    "BookUpdate": {
      "description": "New total at one price level; quantity 0 means the level is gone.",
      "type": "object",
      "required": [
        "type",
        "seq",
        "simTime",
        "symbol",
        "side",
        "price",
        "quantity",
        "orderCount"
      ],
      "properties": {
        "type": {
          "const": "BookUpdate"
        },
        "seq": {
          "$ref": "../common.schema.json#/$defs/seq"
        },
        "simTime": {
          "$ref": "../common.schema.json#/$defs/simTime"
        },
        "symbol": {
          "$ref": "../common.schema.json#/$defs/symbol"
        },
        "side": {
          "$ref": "../common.schema.json#/$defs/side"
        },
        "price": {
          "$ref": "../common.schema.json#/$defs/price"
        },
        "quantity": {
          "$ref": "../common.schema.json#/$defs/quantityOrZero"
        },
        "orderCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "SessionStateChanged": {
      "description": "The market session moved to a new state.",
      "type": "object",
      "required": [
        "type",
        "seq",
        "simTime",
        "state"
      ],
      "properties": {
        "type": {
          "const": "SessionStateChanged"
        },
        "seq": {
          "$ref": "../common.schema.json#/$defs/seq"
        },
        "simTime": {
          "$ref": "../common.schema.json#/$defs/simTime"
        },
        "state": {
          "$ref": "../common.schema.json#/$defs/sessionState"
        }
      }
    }
  }
}
