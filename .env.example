# Copy to .env and fill in. .env is git-ignored; never commit real secrets.
# Values below are local-development placeholders. More variables arrive with S2 (infra) and later sessions.

# PostgreSQL
POSTGRES_DB=prayog
POSTGRES_USER=prayog
POSTGRES_PASSWORD=change-me

# Keycloak admin
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me

# Simulated clock (see docs/BUILD_PLAN.md section 16.1, item 16)
SIM_CLOCK_MULTIPLIER=1
SIM_DAY_OPEN=09:15
SIM_DAY_CLOSE=15:30
