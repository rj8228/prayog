# Copy to .env and fill in, or run `make env` to generate one with random local secrets.
# .env is git-ignored; never commit real secrets. Used by deploy/compose/compose.yaml through the Makefile.

# PostgreSQL (Prayog's database)
POSTGRES_DB=prayog
POSTGRES_USER=prayog
POSTGRES_PASSWORD=change-me

# Keycloak: admin console login, and its own database user (created by deploy/compose/postgres/init)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
KEYCLOAK_DB_PASSWORD=change-me

# Keycloak realm "prayog": imported on first start with these values substituted.
# A bot's "API key" is its client id + secret (BUILD_PLAN 16.2 #21).
PRAYOG_BOT_DEMO_SECRET=change-me
PRAYOG_AGENTS_SECRET=change-me
# Scripts that act as ops/admin (make e2e): client prayog-ops-tool.
PRAYOG_OPS_TOOL_SECRET=change-me
PRAYOG_TRADER1_PASSWORD=change-me
PRAYOG_OPS1_PASSWORD=change-me
# Admin: trades like trader1 and also has the admin console (ops + admin roles).
PRAYOG_ADMIN1_PASSWORD=change-me

# Simulated clock (see docs/BUILD_PLAN.md section 16.1, item 16)
SIM_CLOCK_MULTIPLIER=1
SIM_DAY_OPEN=09:15
SIM_DAY_CLOSE=15:30

# Optional: your own admin user (roles trader, ops, admin), created by `make users` / `make up`. Leave empty to skip.
PRAYOG_EXTRA_ADMIN_USER=
PRAYOG_EXTRA_ADMIN_PASSWORD=
